{
  "name": "ecommerce-modular",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.9 <25"
  },
  "scripts": {
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "vite build --config apps/web/vite.config.mts",
    "build": "tsc -p tsconfig.api.json && vite build --config apps/web/vite.config.mts",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.e2e.json",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "tsc -p tsconfig.api.json && jest --config jest.config.cjs --runInBand --testPathPatterns=unit",
    "test:web": "vitest run --config apps/web/vite.config.mts",
    "test:e2e": "node scripts/e2e.mjs",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "db:migrate": "node dist/apps/api/src/cli.js migrate",
    "seed": "node dist/apps/api/src/cli.js seed",
    "start": "node dist/apps/api/src/main.js",
    "dev:web": "vite --config apps/web/vite.config.mts",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write apps packages tests scripts *.json *.cjs *.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "18.4.0-beta.17",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
